# =====================================================================
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
#     cp .env.example .env
#
# `.env` sudah masuk .gitignore - JANGAN pernah meng-commit nilai asli,
# apalagi secret produksi.
# =====================================================================

# ---- PostgreSQL ----
POSTGRES_USER=shopflow
POSTGRES_PASSWORD=shopflow

# ---- RabbitMQ ----
RABBITMQ_USER=shopflow
RABBITMQ_PASSWORD=shopflow

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT ----
# WAJIB minimal 32 karakter (HS256 butuh key >= 256 bit).
# Buat yang benar dengan:  openssl rand -base64 48
JWT_SECRET=shopflow-development-secret-key-change-me-32chars
JWT_ISSUER=shopflow-identity
JWT_ACCESS_TOKEN_TTL=30m

# ---- Token antar-service untuk endpoint /api/v1/internal/** ----
INTERNAL_API_TOKEN=shopflow-internal-dev-token

# ---- CORS (origin frontend) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Seed akun admin development ----
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@shopflow.dev
SEED_ADMIN_PASSWORD=admin12345

# ---- Simulasi payment gateway ----
# 1.0 = selalu sukses, 0.0 = selalu gagal (untuk menguji alur gagal)
SHOPFLOW_PAYMENT_SUCCESS_RATE=0.9

# ---- Grafana ----
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# =====================================================================
# Frontend (frontend/web/.env.local)
# =====================================================================
# API_BASE_URL=http://localhost:8080
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
