# ─────────────────────────────────────────────────────────────────────────────
# ShopFlow storefront — production image
#
# Three stages:
#   deps    → install dependencies only (cached until the lockfile changes)
#   builder → compile the Next.js app into `.next/standalone`
#   runner  → minimal runtime image with the standalone output, running as non-root
#
# Build:
#   docker build -t shopflow-web \
#     --build-arg API_BASE_URL=http://api-gateway:8080 .
#
# Run (inside the compose network, where `api-gateway` resolves):
#   docker run --rm -p 3000:3000 -e API_BASE_URL=http://api-gateway:8080 shopflow-web
# ─────────────────────────────────────────────────────────────────────────────

# ---------- base ----------
FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    NEXT_TELEMETRY_DISABLED=1 \
    CI=1
# corepack ships with Node and pins pnpm from package.json's "packageManager" field.
RUN corepack enable
WORKDIR /app

# ---------- deps ----------
FROM base AS deps
# Only the manifests, so this layer is reused until dependencies actually change.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# The repository's pnpm-workspace.yaml pins an absolute storeDir for the *developer*
# machine (the sandbox's home directory is read-only). That path is meaningless inside the
# image, so drop it and let pnpm use its default store.
RUN sed -i '/^storeDir:/d' pnpm-workspace.yaml

RUN pnpm install --frozen-lockfile

# ---------- builder ----------
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time.
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL

# API_BASE_URL is read by the middleware, which is bundled at build time, so it must be
# present here as well as at runtime. Override it at runtime to point elsewhere.
ARG API_BASE_URL=http://api-gateway:8080
ENV API_BASE_URL=$API_BASE_URL

RUN pnpm build

# ---------- runner ----------
FROM node:22-alpine AS runner
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    API_BASE_URL=http://api-gateway:8080

WORKDIR /app

# Run as an unprivileged user: never ship a container that runs as root.
RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 --ingroup nodejs nextjs

# The standalone bundle already contains the traced `node_modules` subset and `server.js`.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 3000

# Lightweight healthcheck against the app itself.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# `server.js` is generated by `output: 'standalone'`.
CMD ["node", "server.js"]
