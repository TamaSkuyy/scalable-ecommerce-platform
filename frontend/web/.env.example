# ──────────────────────────────────────────────────────────────────────────────
# ShopFlow storefront — environment variables
# Copy to `.env.local` for local development:  cp .env.example .env.local
# ──────────────────────────────────────────────────────────────────────────────

# Address of the API gateway AS SEEN FROM THE NEXT.JS SERVER.
# No NEXT_PUBLIC_ prefix on purpose: the browser must never talk to the gateway
# directly. All browser traffic goes through /api/v1/* and is proxied by
# src/middleware.ts, which injects the Bearer token from the httpOnly cookie.
#
# Local development (gateway on your machine):
API_BASE_URL=http://localhost:8080
#
# Docker Compose (the gateway container is reachable by its service name):
# API_BASE_URL=http://api-gateway:8080

# Public origin of this storefront. Used for metadataBase / canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
